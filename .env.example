APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# deploy.sh пишет сюда git SHA после pull (manifest резервных копий).
APP_VERSION=1.0.0

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vovremya
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Media disk (аватары). S3 включается только MEDIA_DRIVER=s3 — см. docs/S3_AVATARS.md
MEDIA_DRIVER=local
MEDIA_S3_KEY=
MEDIA_S3_SECRET=
MEDIA_S3_REGION=ru-1
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=https://s3.twcstorage.ru
MEDIA_S3_PATH_STYLE=true
MEDIA_PUBLIC_URL=

# Резервные копии БД (см. docs/DB_BACKUPS.md). Отдельный приватный бакет,
# не связан с MEDIA_* и AWS_*. Ключи — только на сервере, сюда не вписывать.
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=ru-1
BACKUP_S3_BUCKET=irsi-db-backups
BACKUP_S3_ENDPOINT=https://s3.twcstorage.ru
BACKUP_S3_PATH_STYLE=true
BACKUP_S3_PREFIX=irsi-app
# Ежедневный автозапуск 03:30 Europe/Moscow; по умолчанию выключен.
BACKUP_SCHEDULED_ENABLED=false
# Сколько последних успешных копий хранить (отдельно manual/scheduled).
BACKUP_KEEP_SCHEDULED=7
BACKUP_KEEP_MANUAL=7

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_APP_ID=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

INERTIA_SSR_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_WEBHOOK_URL=

MAX_BOT_TOKEN=
MAX_BOT_NAME=
MAX_SECRET_TOKEN=your_webhook_secret_here
MAX_API_URL=https://botapi.max.ru/v1

VK_APP_ID=
VK_APP_SECRET=
VK_BOT_TOKEN=
VK_SECRET_TOKEN=
VK_CONFIRMATION_TOKEN=
VK_API_VERSION=5.199
VK_GROUP_ID=

VK_ID_APP_ID=
VK_ID_REDIRECT_URI=https://irsi-app.ru/auth/vk/callback

# Legacy mock billing webhook secret (fail-closed: empty = disabled)
LEGACY_MOCK_WEBHOOK_SECRET=

# Enable Core entitlement reader (default: false, flip after parity verification)
BILLING_CORE_ENTITLEMENT=false

TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_BASE_URL=https://securepay.tinkoff.ru
# T-Bank payment environment snapshotted onto each new tbank attempt:
# 'demo' or 'live' only. Any other value is treated as 'demo' (never live).
# Affects new attempts only — changing it later does not rewrite existing rows.
TBANK_ENVIRONMENT=demo

# Seller INN (ИНН продавца) for manual NPD receipts on lknpd.nalog.ru.
# Must be 10 or 12 digits. While empty/malformed, receipt links cannot be attached.
BILLING_RECEIPTS_SELLER_INN=

# Card checkout link lifetime (RedirectDueDate), minutes. Default 30.
# T-Bank allows 1 minute … 90 days; out-of-range values are clamped in config/billing.php.
BILLING_CARD_REDIRECT_TTL_MINUTES=30
